# Copiar a ".env" para personalizar docker-compose (el archivo .env NO se sube a GitHub)

# ── Aplicación ──────────────────────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=production

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=ceramica
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=ceramica
DATABASE_URL=postgres://ceramica:cambia_esta_clave@db:5432/ceramica

# ── Logs ─────────────────────────────────────────────────────────────────────
# Nivel de log: error | warn | info | debug
LOG_LEVEL=info

# ── CORS (separados por coma, vacío = sin restricción) ───────────────────────
ALLOWED_ORIGINS=http://localhost:3000
